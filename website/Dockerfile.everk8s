# syntax=docker/dockerfile:1
# Multi-stage build for the Ever Gauzy Docs static site, built with Sourcey.
# Build context = repo `website/` subdir (self-contained: package.json + yarn.lock).

# ---- Build stage ----
FROM node:26-alpine AS build

WORKDIR /app

# Optional private-registry auth for npm deps.
ARG NPM_TOKEN=""
RUN if [ -n "$NPM_TOKEN" ]; then \
      printf '//registry.npmjs.org/:_authToken=%s\n' "$NPM_TOKEN" > /root/.npmrc; \
    fi

# Enable Yarn (classic) via corepack. Node 25+ no longer bundles corepack (`corepack enable` exits 127 on
# node:26-alpine), so install it first.
RUN npm install -g corepack@0.36.0 && corepack enable

# Install dependencies first for better layer caching.
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

# Copy the rest of the site source and build the static output.
COPY . .
ENV NODE_ENV=production
RUN yarn build
# No U+0000 in any page: React 18 wrote one to three zero bytes before a multi-byte character that
# straddled its 2048-byte SSR chunk, and docs.gauzy.co served them (scripts/check-no-nul-bytes.mjs).
RUN node scripts/check-no-nul-bytes.mjs build

# Drop any registry auth so it can't leak into later layers/artifacts.
RUN rm -f /root/.npmrc

# ---- Serve stage ----
FROM nginx:alpine AS serve
# Sourcey emits a fully static, multi-page site into build/.
COPY --from=build /app/build /usr/share/nginx/html

# Relative directory redirects (no http:// downgrade) and the site's own 404 page.
# See nginx-default.conf for why.
COPY nginx-default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
